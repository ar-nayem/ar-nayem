# Use an ABSOLUTE path, not a relative one: the Prisma CLI resolves a
# relative "file:./x.db" against the prisma/ folder, but the running app
# resolves it against its own working directory — the two disagree, so a
# relative path here silently points at two different files. e.g.:
# DATABASE_URL="file:/home/youruser/apps/printing-app/prisma/prod.db"
DATABASE_URL="file:/absolute/path/to/printing-app/prisma/prod.db"

# The password you type in at printing.ar9.top/dashboard/login.
ADMIN_PASSWORD="pick-a-strong-password"

# Random secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-generated-random-value"

# Optional: where uploaded customer files are stored on disk.
# Defaults to ./data/uploads if not set. Point this at a path outside the
# app directory if you want uploads to survive `git pull` / redeploys more
# obviously (the default is already git-ignored and untouched by deploys).
# UPLOAD_DIR="/var/lib/printing-app/uploads"
