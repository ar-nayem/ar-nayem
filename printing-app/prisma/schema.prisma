// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id String @id @default(cuid())

  customerName  String
  customerPhone String
  notes         String?

  originalName String
  storedName   String
  fileKind     String // "pdf" | "image"
  mimeType     String
  fileSize     Int

  pages     Int
  pageRange String? // e.g. "1-3,5" — null/empty means all pages
  copies    Int
  color     Boolean
  duplex    Boolean

  pricePerPage Float
  totalPrice   Float

  // "pending" | "printing" | "ready" | "completed" | "cancelled"
  status String @default("pending")

  // No payment API access (would need a Chinese business license) — admin
  // sees the WeChat/Alipay QR on the confirmation page like the customer
  // does, notices the payment notification on their own phone, and taps
  // "Mark paid" in the dashboard. Manual, but free and license-free.
  paid   Boolean   @default(false)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Costs entered manually by the admin (paper, ink, maintenance, etc.) so
// the finance tab can show real profit, not just order revenue.
model Expense {
  id String @id @default(cuid())

  description String
  category    String // "paper" | "ink" | "maintenance" | "other"
  amount      Float
  date        DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([date])
}
